# Grafana admin login. Change the password before exposing port 3000.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# External Docker network shared with the application Compose project.
# Create it once: docker network create <this value>
# The app metrics service must join a network with this same name.
OBSERVABILITY_NETWORK=techblog-observability

# Compose project name of this monitoring stack. Changing it starts new volumes.
MONITORING_COMPOSE_NAME=techblog-observability

# Must match job_name for the app in prometheus/prometheus.yml.
# Grafana dashboard queries use this label. Changing it here does not
# change what Prometheus scrapes; edit prometheus.yml for the target.
APP_JOB_NAME=techblog-backend

# Must match the `name:` at the top of the application compose file.
# cAdvisor panels and the Loki log panel filter on this value.
APP_COMPOSE_PROJECT=techblog

# Metric names and handler label matcher the application exports.
# APP_ROUTE_FILTER is a Prometheus regex, for example /api/.*
APP_HTTP_REQUESTS_METRIC=http_requests_total
APP_HTTP_DURATION_BUCKET_METRIC=http_request_duration_seconds_bucket
APP_PROCESS_MEMORY_METRIC=process_resident_memory_bytes
APP_ROUTE_FILTER=/api/.*

# Short name used in the status and log panel titles.
APP_DISPLAY_NAME=TechBlog

# Grafana dashboard title and uid. Keep the uid stable to update the same dashboard.
DASHBOARD_TITLE="TechBlog Observability"
DASHBOARD_UID=techblog-observability

# Folder and provider name shown in Grafana.
GRAFANA_FOLDER=TechBlog
GRAFANA_DASHBOARD_PROVIDER=TechBlog
