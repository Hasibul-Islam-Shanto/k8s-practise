# Copy this file to .env before `docker compose up`.
# Change the passwords and JWT_SECRET before sharing this stack.
# Passwords used in DATABASE_URL must be percent-encoded if they contain
# @, :, /, or other URL-reserved characters.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=techblog
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=tech_blog

# Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=http://localhost
LOG_LEVEL=INFO

# Baked into the frontend image at build time. The relative path is proxied by nginx.
VITE_API_URL=/api/v1
